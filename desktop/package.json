{
  "name": "jarvis-desktop",
  "version": "0.1.0",
  "description": "A personal JARVIS-style desktop assistant — HUD dashboard, real speech-to-speech voice, and a safe launcher for your own apps.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:linux": "electron-builder --linux AppImage",
    "dist:win": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dmg"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.jarvis.desktop",
    "productName": "Jarvis",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "ask-popup.html",
      "assets/**/*",
      "config.example.json",
      "!clap-launcher.js"
    ],
    "directories": {
      "output": "dist"
    },
    "linux": {
      "target": ["AppImage"],
      "icon": "assets/icon.png",
      "category": "Utility"
    },
    "win": {
      "target": ["nsis"],
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": ["dmg"],
      "icon": "assets/icon.icns",
      "category": "public.app-category.productivity"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
